# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# Every setting the application reads must be documented here.
# Run commands from the repository root so `.env` is found.

# --- Application -------------------------------------------------
SIA_ENV=development            # development | test | production
SIA_LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR
SIA_LOG_FORMAT=console         # console (human-readable) | json (production)

# --- PostgreSQL (used by compose.yaml and the API) ---------------
POSTGRES_HOST=127.0.0.1      # not "localhost": on Windows that tries IPv6 first (+2s per connection)
POSTGRES_PORT=5432
POSTGRES_DB=sia_dev
# Owner role: owns the schema, runs migrations. Never used by the running API.
POSTGRES_USER=sia
POSTGRES_PASSWORD=change-me-locally
# Restricted runtime role `sia_app` used by the API: no superuser, cannot bypass
# Row-Level Security, cannot change the schema. See docs/adr/0007.
SIA_APP_DB_PASSWORD=change-me-too

# --- Background worker (optional) -------------------------------
# SIA_WORKER_CONCURRENCY=4

# --- Authentication (optional; defaults shown) -------------------
# SIA_SESSION_IDLE_TIMEOUT_HOURS=168        # logged out after 7 days without activity
# SIA_SESSION_ABSOLUTE_TIMEOUT_HOURS=720    # and after 30 days regardless
# SIA_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]  # frontend origins (CSRF)
# SIA_LOGIN_MAX_FAILURES_PER_EMAIL=5
# SIA_LOGIN_MAX_FAILURES_PER_IP=20
# SIA_LOGIN_FAILURE_WINDOW_MINUTES=15

# --- AI enrichment ----------------------------------------------
# ANTHROPIC_API_KEY=                       # needed to enrich companies (never commit it)
# SIA_ENRICHMENT_MODEL=claude-opus-5-5
# SIA_ENRICHMENT_EFFORT=low                # low | medium | high
# SIA_ENRICHMENT_DAILY_LIMIT=200           # companies per organization per day (cost guard)
# SIA_LLM_PROVIDER=anthropic               # "fake" for offline demos/tests (refused in production)
# SIA_FETCH_PROVIDER=web                   # "fake" for offline demos/tests (refused in production)

# --- AI account briefs (uses the same ANTHROPIC_API_KEY) ----------
# SIA_BRIEF_MODEL=claude-opus-5-5
# SIA_BRIEF_EFFORT=medium                   # low | medium | high
# SIA_BRIEF_DAILY_LIMIT=50                  # briefs per organization per day (cost guard)
