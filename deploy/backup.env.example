# Backup settings. Copy to /opt/sia/deploy/backup.env on the server.

# The GPG key ID (or e-mail) of the backup PUBLIC key imported on the server
# (gpg --import backup-public.asc). Its private key must NOT be on the server.
BACKUP_GPG_RECIPIENT=

# How many backups to keep on the server.
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4

# Optional: an rclone remote for an off-server copy (e.g. "b2:sia-backups"); needs rclone.
# BACKUP_REMOTE=

# Optional: heartbeat URL pinged after every successful backup (e.g. healthchecks.io); it
# alerts you when a ping doesn't arrive.
# BACKUP_PING_URL=
