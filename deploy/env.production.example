# Production settings. Copy to deploy/.env.production ON THE SERVER and fill in.
# Never commit the real file (it is git-ignored). Generate each password with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Public hostname (Caddy gets the HTTPS certificate for it) and the matching browser origin.
SITE_ADDRESS=sia-demo.duckdns.org
SIA_ALLOWED_ORIGINS=["https://sia-demo.duckdns.org"]

# Database (owner role: migrations only) and the restricted runtime role.
POSTGRES_DB=sia
POSTGRES_USER=sia_owner
POSTGRES_PASSWORD=
SIA_APP_DB_PASSWORD=

# Logs as JSON lines (for log tools); INFO is a good default.
SIA_LOG_FORMAT=json
SIA_LOG_LEVEL=INFO

# AI. Use a SEPARATE production key with a spend limit set in the Anthropic console.
ANTHROPIC_API_KEY=
# SIA_ENRICHMENT_MODEL=claude-opus-5-5
# SIA_BRIEF_MODEL=claude-opus-5-5

# Error monitoring (optional): the DSN from your Sentry project's "Client Keys" page.
# The browser bundle gets the same DSN at BUILD time (VITE_SENTRY_DSN, see compose file).
SENTRY_DSN=

# Cost protection (decisions 2026-11-04): AI pauses for everyone once this month's estimated
# spend reaches the budget; public signups get no AI (operator enables it per organisation).
SIA_AI_MONTHLY_BUDGET_USD=10
SIA_AI_ENABLED_FOR_NEW_ORGS=false
